# Restrictive-network browser profile.
# Copy to .env.local for a relay-only validation build. The controller registers
# ordinary TURN UDP/TCP plus TURN/TLS, then forces ICE to select a relay path.

VITE_SIGNAL_URL=wss://control.example.com/ws
# Optional stable browser peer ID. If omitted, DeskLink creates an ephemeral web-* ID.
VITE_SIGNAL_DEVICE_ID=web-controller-01

# Production-style browser authentication. The user enters the controller account
# and controller key at runtime. The server returns a short-lived target-scoped
# session token that remains only in memory and is carried in the WebSocket
# subprotocol request rather than the URL query string.
VITE_CONTROLLER_SESSION_URL=https://control.example.com/api/v1/controller-session
VITE_CONTROLLER_AUTH_REQUIRED=1

VITE_STUN_URL=stun:turn.example.com:3478
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_TLS_URL=turns:turn.example.com:5349
VITE_TURN_CREDENTIALS_URL=https://control.example.com/api/v1/turn-credentials
VITE_TURN_RUNTIME_REQUIRED=1
VITE_ICE_TRANSPORT_POLICY=relay

# Development-only fallbacks. Do not ship long-lived TURN credentials or a static
# VITE_SIGNAL_AUTH_TOKEN in a public browser bundle because all VITE_* values are
# embedded in static JavaScript at build time.
# VITE_SIGNAL_AUTH_TOKEN=CONTROLLED_TEST_TOKEN
# VITE_TURN_USERNAME=TEMPORARY_TURN_USERNAME
# VITE_TURN_PASSWORD=TEMPORARY_TURN_PASSWORD
