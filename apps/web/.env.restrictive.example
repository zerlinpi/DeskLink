# Restrictive-network browser profile.
# Use this when UDP and ordinary TURN/TCP are blocked and a valid TURN/TLS
# endpoint is available. Copy to .env.local for a dedicated test build.

VITE_SIGNAL_URL=wss://control.example.com/ws
VITE_STUN_URL=stun:turn.example.com:3478
VITE_TURN_URL=turns:turn.example.com:5349
VITE_TURN_USERNAME=TEMPORARY_TURN_USERNAME
VITE_TURN_PASSWORD=TEMPORARY_TURN_PASSWORD
