# Restrictive-network browser profile.
# Copy to .env.local for a relay-only validation build. The controller registers
# ordinary TURN UDP/TCP plus TURN/TLS, then forces ICE to select a relay path.

VITE_SIGNAL_URL=wss://control.example.com/ws
VITE_SIGNAL_DEVICE_ID=web-controller-01
VITE_SIGNAL_AUTH_TOKEN=SHORT_LIVED_TOKEN
VITE_STUN_URL=stun:turn.example.com:3478
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_TLS_URL=turns:turn.example.com:5349
VITE_TURN_CREDENTIALS_URL=https://control.example.com/api/v1/turn-credentials
VITE_TURN_RUNTIME_REQUIRED=1
VITE_ICE_TRANSPORT_POLICY=relay

# Development-only fallback when the runtime credential endpoint is not enabled.
# Do not ship long-lived TURN credentials in a public web bundle.
# VITE_TURN_USERNAME=TEMPORARY_TURN_USERNAME
# VITE_TURN_PASSWORD=TEMPORARY_TURN_PASSWORD

# The signaling token must be minted for exactly VITE_SIGNAL_DEVICE_ID.
# VITE_* values are embedded in the static bundle, so this profile is for controlled
# validation only. A production account shell should inject short-lived credentials
# into the browser session after authenticating the user.
