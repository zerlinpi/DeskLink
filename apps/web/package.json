{
  "name": "@desklink/web",
  "private": true,
  "version": "1.0.5-dev",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "verify:runtime-config": "node scripts/verify-runtime-config.mjs",
    "build": "npm run typecheck && vite build && npm run verify:runtime-config"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2",
    "vite": "7.3.5",
    "vitest": "3.2.7"
  }
}
