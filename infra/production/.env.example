# Public DNS name pointing to this server.
DESKLINK_DOMAIN=control.example.com

# Public IPv4 address used by coturn for relay candidates. If the host is behind
# NAT, this is the public/NAT address rather than the private interface address.
DESKLINK_PUBLIC_IP=203.0.113.10
DESKLINK_TURN_HOST=control.example.com

# Generated by ./bootstrap.sh. Keep these values private and stable across
# container restarts; rotating them invalidates outstanding short-lived tokens.
DESKLINK_SIGNAL_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
DESKLINK_TURN_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

DESKLINK_SIGNAL_IMAGE=ghcr.io/zerlinpi/desklink-signal:latest
DESKLINK_CONTROLLER_SESSION_TTL=15m
DESKLINK_SIGNAL_TOKEN_TTL=15m
DESKLINK_TURN_CREDENTIAL_TTL_SECONDS=43200
DESKLINK_ICE_TRANSPORT_POLICY=all

# Optional TURN/TLS endpoint. Leave blank until coturn has a certificate/key and
# TCP 5349 is exposed.
DESKLINK_TURN_TLS_URL=
